{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-kernel-manifest",
  "title": "Coding Kernel Boundary Manifest",
  "type": "object",
  "required": ["schema", "executors"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "governanceSurfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surfaces", "repositories"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "governance": {
            "type": "boolean"
          },
          "defaultRepository": {
            "type": "string"
          }
        }
      }
    }
  }
}
